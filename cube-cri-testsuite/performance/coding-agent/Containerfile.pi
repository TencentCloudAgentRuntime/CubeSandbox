# syntax=docker/dockerfile:1.7
# 仅提供 Pi 运行环境；任务初始文件由 TASK_BASE_IMAGE 提供，官方 tests 不进入本镜像。
ARG TASK_BASE_IMAGE
FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90 AS pi
ARG PI_VERSION=0.85.1
RUN npm install --global --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && test "$(pi --version)" = "${PI_VERSION}"

FROM ${TASK_BASE_IMAGE}
USER root
ARG UV_VERSION=0.7.13
ARG UV_INSTALLER_SHA256=1bd6dcfae3377079ed9ebeb47cc814b0a9b6f42a81089e97de49cd26f7b9d2d2
ARG UV_TARBALL_SHA256=909278eb197c5ed0e9b5f16317d1255270d1f9ea4196e7179ce934d48c4c2545
ARG VERIFIER_UV_DEPS="pytest==8.4.1 requests==2.32.4"
COPY --from=pi /usr/local /usr/local
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl git jq python3 python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --shell /bin/bash agent
RUN mkdir -p /opt/agc37/verifier-cache /opt/agc37/verifier-bin \
 && curl -fsSL "https://astral.sh/uv/${UV_VERSION}/install.sh" -o /opt/agc37/verifier-cache/uv-install.sh \
 && echo "${UV_INSTALLER_SHA256}  /opt/agc37/verifier-cache/uv-install.sh" | sha256sum -c - \
 && curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" -o /opt/agc37/verifier-cache/uv.tar.gz \
 && echo "${UV_TARBALL_SHA256}  /opt/agc37/verifier-cache/uv.tar.gz" | sha256sum -c -
RUN mkdir -p /opt/agc37/verifier-uv /opt/agc37/uv-bootstrap \
 && tar -xzf /opt/agc37/verifier-cache/uv.tar.gz -C /opt/agc37/uv-bootstrap --strip-components=1 \
 && UV_CACHE_DIR=/opt/agc37/verifier-uv /opt/agc37/uv-bootstrap/uv venv /tmp/agc37-verifier-venv \
 && UV_CACHE_DIR=/opt/agc37/verifier-uv /opt/agc37/uv-bootstrap/uv pip install --python /tmp/agc37-verifier-venv/bin/python ${VERIFIER_UV_DEPS} \
 && rm -rf /tmp/agc37-verifier-venv /opt/agc37/uv-bootstrap
COPY models.json /opt/agc37/models.json
COPY scripts/agent-run.sh scripts/run-terminal-agent.sh scripts/keep-artifacts.sh scripts/sanitize-pi.py scripts/sample-resources.py scripts/verify-terminal.sh scripts/verifier-curl.sh scripts/verifier-apt-get.sh /opt/agc37/
RUN chmod 0755 /opt/agc37/agent-run.sh /opt/agc37/run-terminal-agent.sh /opt/agc37/keep-artifacts.sh /opt/agc37/verify-terminal.sh /opt/agc37/sanitize-pi.py /opt/agc37/sample-resources.py /opt/agc37/verifier-curl.sh /opt/agc37/verifier-apt-get.sh \
 && ln -s /opt/agc37/verifier-curl.sh /opt/agc37/verifier-bin/curl \
 && ln -s /opt/agc37/verifier-apt-get.sh /opt/agc37/verifier-bin/apt-get \
 && pi --version \
 && mkdir -p /artifacts /pi-state
ENV PI_TELEMETRY=0 \
    PI_SKIP_VERSION_CHECK=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /app
