+func aggregateSandboxStats(css []containerStats, runningContainerIDs map[string]struct{}, memoryLimit int64) (*runtime.CpuUsage, *runtime.MemoryUsage, *runtime.IoUsage, bool) {
+	if len(runningContainerIDs) == 0 {
+		return nil, nil, nil, false
+	}
+
+	cpu := &runtime.CpuUsage{}
+	memory := &runtime.MemoryUsage{}
+	var io *runtime.IoUsage
+	seen := make(map[string]struct{}, len(runningContainerIDs))
+	nanoCoresComplete := true
+	for _, cs := range css {
+		stats := cs.stats
+		id := stats.GetAttributes().GetId()
+		if _, running := runningContainerIDs[id]; !running {
+			continue
+		}
+		if _, duplicate := seen[id]; duplicate {
+			return nil, nil, nil, false
+		}
+		seen[id] = struct{}{}
+
+		containerCPU := stats.GetCpu()
+		containerMemory := stats.GetMemory()
+		if containerCPU == nil || containerCPU.UsageCoreNanoSeconds == nil ||
+			containerMemory == nil || containerMemory.WorkingSetBytes == nil ||
+			containerMemory.UsageBytes == nil || containerMemory.RssBytes == nil ||
+			containerMemory.PageFaults == nil || containerMemory.MajorPageFaults == nil {
+			return nil, nil, nil, false
+		}
+
+		cpu.Timestamp = max(cpu.Timestamp, containerCPU.Timestamp)
+		addUInt64(&cpu.UsageCoreNanoSeconds, containerCPU.UsageCoreNanoSeconds)
+		if containerCPU.UsageNanoCores == nil {
+			nanoCoresComplete = false
+		} else {
+			addUInt64(&cpu.UsageNanoCores, containerCPU.UsageNanoCores)
+		}
+		memory.Timestamp = max(memory.Timestamp, containerMemory.Timestamp)
+		addUInt64(&memory.WorkingSetBytes, containerMemory.WorkingSetBytes)
+		addUInt64(&memory.UsageBytes, containerMemory.UsageBytes)
+		addUInt64(&memory.RssBytes, containerMemory.RssBytes)
+		addUInt64(&memory.PageFaults, containerMemory.PageFaults)
+		addUInt64(&memory.MajorPageFaults, containerMemory.MajorPageFaults)
+
+		if len(runningContainerIDs) == 1 {
+			value := stats.GetIo()
+			if value == nil {
+				continue
+			}
+			if io == nil {
+				io = &runtime.IoUsage{}
+			}
+			io.Timestamp = max(io.Timestamp, value.Timestamp)
+			io.Psi = value.Psi
+		}
+	}
+	if len(seen) != len(runningContainerIDs) {
+		return nil, nil, nil, false
+	}
+	if !nanoCoresComplete {
+		cpu.UsageNanoCores = nil
+	}
+	if memoryLimit > 0 && !isMemoryUnlimited(uint64(memoryLimit)) {
+		available := uint64(0)
+		if memory.WorkingSetBytes.Value < uint64(memoryLimit) {
+			available = uint64(memoryLimit) - memory.WorkingSetBytes.Value
+		}
+		memory.AvailableBytes = &runtime.UInt64Value{Value: available}
+	}
+
+	// PSI cannot be reconstructed from sibling cgroups because their stall
+	// intervals may overlap. With exactly one running container, its PSI is the
+	// workload PSI; otherwise leave Pod PSI unavailable until the sandbox
+	// controller supplies native Guest Pod cgroup metrics.
+	if len(runningContainerIDs) == 1 {
+		for _, cs := range css {
+			if _, running := runningContainerIDs[cs.stats.GetAttributes().GetId()]; !running {
+				continue
+			}
+			cpu.Psi = cs.stats.GetCpu().GetPsi()
+			memory.Psi = cs.stats.GetMemory().GetPsi()
+		}
+	}
+	return cpu, memory, io, true
+}
+
+func applySandboxPressure(cpu *runtime.CpuUsage, memory *runtime.MemoryUsage, io *runtime.IoUsage, hostCPU *runtime.CpuUsage, hostMemory *runtime.MemoryUsage, hostIO *runtime.IoUsage) *runtime.IoUsage {
+	if cpu != nil && hostCPU != nil && hostCPU.Psi != nil {
+		cpu.Psi = hostCPU.Psi
+	}
+	if memory != nil && hostMemory != nil && hostMemory.Psi != nil {
+		memory.Psi = hostMemory.Psi
+	}
+	if hostIO != nil && hostIO.Psi != nil {
+		if io == nil {
+			io = &runtime.IoUsage{}
+		}
+		io.Timestamp = hostIO.Timestamp
+		io.Psi = hostIO.Psi
+	}
+	return io
+}
