+func TestSandboxMemoryLimit(t *testing.T) {
+	newSandbox := func(initial int64, updated *runtime.ContainerResources) sandboxstore.Sandbox {
+		return sandboxstore.NewSandbox(sandboxstore.Metadata{
+			Config: &runtime.PodSandboxConfig{Linux: &runtime.LinuxPodSandboxConfig{
+				Resources: &runtime.LinuxContainerResources{MemoryLimitInBytes: initial},
+			}},
+		}, sandboxstore.Status{Resources: updated})
+	}
+
+	tests := []struct {
+		name    string
+		sandbox sandboxstore.Sandbox
+		want    int64
+	}{
+		{name: "initial", sandbox: newSandbox(100, nil), want: 100},
+		{name: "updated", sandbox: newSandbox(100, &runtime.ContainerResources{Linux: &runtime.LinuxContainerResources{MemoryLimitInBytes: 200}}), want: 200},
+		{name: "updated cleared", sandbox: newSandbox(100, &runtime.ContainerResources{Linux: &runtime.LinuxContainerResources{}}), want: 0},
+		{name: "updated linux absent", sandbox: newSandbox(100, &runtime.ContainerResources{}), want: 0},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := sandboxMemoryLimit(test.sandbox); got != test.want {
+				t.Fatalf("sandboxMemoryLimit()=%d, want %d", got, test.want)
+			}
+		})
+	}
+}
