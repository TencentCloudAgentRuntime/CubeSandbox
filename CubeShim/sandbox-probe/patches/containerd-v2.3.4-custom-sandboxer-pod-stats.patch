+func sandboxMemoryLimit(sandbox sandboxstore.Sandbox) int64 {
+	resources := sandbox.Status.Get().Resources
+	if resources != nil {
+		return resources.GetLinux().GetMemoryLimitInBytes()
+	}
+	return sandbox.Metadata.Config.GetLinux().GetResources().GetMemoryLimitInBytes()
+}
