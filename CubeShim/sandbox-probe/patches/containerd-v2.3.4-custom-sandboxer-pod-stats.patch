+func TestAggregateSandboxStatsSingleContainerPreservesPSI(t *testing.T) {
+	psi := &runtime.PsiStats{Some: &runtime.PsiData{Total: 13}}
+	css := []containerStats{completeContainerStats("a", 10, psi, true)}
+	running := map[string]struct{}{"a": {}}
+
+	cpu, memory, io, complete := aggregateSandboxStats(css, running, 0)
+	if !complete {
+		t.Fatal("single complete container must aggregate")
+	}
+	if cpu.Psi != psi || memory.Psi != psi {
+		t.Fatal("single-container PSI must be preserved")
+	}
+	if memory.AvailableBytes != nil {
+		t.Fatalf("unlimited Pod memory must not synthesize available bytes: %+v", memory.AvailableBytes)
+	}
+	if io == nil || io.Psi != psi {
+		t.Fatalf("single-container IO PSI must be preserved: %+v", io)
+	}
+}
