+func uint64Value(value uint64) *runtime.UInt64Value {
+	return &runtime.UInt64Value{Value: value}
+}
+
+func completeContainerStats(id string, base uint64, psi *runtime.PsiStats, withIO bool) containerStats {
+	stats := &runtime.ContainerStats{
+		Attributes: &runtime.ContainerAttributes{Id: id},
+		Cpu: &runtime.CpuUsage{
+			Timestamp:            int64(base + 1),
+			UsageCoreNanoSeconds: uint64Value(base + 2),
+			UsageNanoCores:       uint64Value(base + 3),
+			Psi:                  psi,
+		},
+		Memory: &runtime.MemoryUsage{
+			Timestamp:       int64(base + 4),
+			WorkingSetBytes: uint64Value(base + 5),
+			AvailableBytes:  uint64Value(base + 6),
+			UsageBytes:      uint64Value(base + 7),
+			RssBytes:        uint64Value(base + 8),
+			PageFaults:      uint64Value(base + 9),
+			MajorPageFaults: uint64Value(base + 10),
+			Psi:             psi,
+		},
+	}
+	if withIO {
+		stats.Io = &runtime.IoUsage{Timestamp: int64(base + 11), Psi: psi}
+	}
+	return containerStats{stats: stats, pids: base + 12}
+}
