+func TestCustomSandboxUsesContainerStats(t *testing.T) {
+	if customSandboxUsesContainerStats(string(criconfig.ModePodSandbox)) {
+		t.Fatal("built-in podsandbox must retain Host cgroup stats")
+	}
+	if !customSandboxUsesContainerStats("shim") {
+		t.Fatal("custom sandboxer must attempt container aggregation")
+	}
+}
+
+func TestApplySandboxPressureUsesHostPodCgroup(t *testing.T) {
+	guestPSI := &runtime.PsiStats{Some: &runtime.PsiData{Avg10: 1}}
+	hostCPU := &runtime.PsiStats{Some: &runtime.PsiData{Avg10: 2}}
+	hostMemory := &runtime.PsiStats{Full: &runtime.PsiData{Avg10: 3}}
+	hostIO := &runtime.PsiStats{Some: &runtime.PsiData{Avg10: 4}}
+	cpu := &runtime.CpuUsage{UsageCoreNanoSeconds: uint64Value(11), Psi: guestPSI}
+	memory := &runtime.MemoryUsage{WorkingSetBytes: uint64Value(12), Psi: guestPSI}
+
+	io := applySandboxPressure(
+		cpu,
+		memory,
+		nil,
+		&runtime.CpuUsage{Timestamp: 20, Psi: hostCPU},
+		&runtime.MemoryUsage{Timestamp: 21, Psi: hostMemory},
+		&runtime.IoUsage{Timestamp: 22, Psi: hostIO},
+	)
+	if cpu.UsageCoreNanoSeconds.Value != 11 || memory.WorkingSetBytes.Value != 12 {
+		t.Fatal("host pressure must not replace aggregated Guest usage")
+	}
+	if cpu.Psi != hostCPU || memory.Psi != hostMemory {
+		t.Fatal("CPU and memory PSI must come from the Host Pod cgroup")
+	}
+	if io == nil || io.Timestamp != 22 || io.Psi != hostIO {
+		t.Fatal("Host Pod cgroup IO PSI must be exposed even without Guest IO")
+	}
+}
+
+func TestApplySandboxPressurePreservesGuestWhenHostPressureMissing(t *testing.T) {
+	guestPSI := &runtime.PsiStats{Some: &runtime.PsiData{Avg10: 1}}
+	cpu := &runtime.CpuUsage{Psi: guestPSI}
+	memory := &runtime.MemoryUsage{Psi: guestPSI}
+	io := &runtime.IoUsage{Timestamp: 7, Psi: guestPSI}
+
+	gotIO := applySandboxPressure(cpu, memory, io, &runtime.CpuUsage{}, &runtime.MemoryUsage{}, &runtime.IoUsage{})
+	if cpu.Psi != guestPSI || memory.Psi != guestPSI || gotIO != io || gotIO.Psi != guestPSI {
+		t.Fatal("missing Host PSI must preserve available Guest pressure")
+	}
+}
