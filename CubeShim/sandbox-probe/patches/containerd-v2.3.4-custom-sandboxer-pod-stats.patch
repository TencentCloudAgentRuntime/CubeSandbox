+func TestAggregateSandboxStatsRejectsIncompleteRunningSet(t *testing.T) {
+	completeA := completeContainerStats("a", 10, nil, false)
+	missingCPU := completeContainerStats("a", 10, nil, false)
+	missingCPU.stats.Cpu = nil
+	missingMemory := completeContainerStats("a", 10, nil, false)
+	missingMemory.stats.Memory = nil
+	missingCoreUsage := completeContainerStats("a", 10, nil, false)
+	missingCoreUsage.stats.Cpu.UsageCoreNanoSeconds = nil
+	duplicateA := completeContainerStats("a", 20, nil, false)
+	cpuOnlyA := completeContainerStats("a", 10, nil, false)
+	cpuOnlyA.stats.Memory = nil
+	memoryOnlyB := completeContainerStats("b", 40, nil, false)
+	memoryOnlyB.stats.Cpu = nil
+	incompleteB := completeContainerStats("b", 40, nil, false)
+	incompleteB.stats.Memory = nil
+	missingWorkingSet := completeContainerStats("a", 10, nil, false)
+	missingWorkingSet.stats.Memory.WorkingSetBytes = nil
+	missingUsage := completeContainerStats("a", 10, nil, false)
+	missingUsage.stats.Memory.UsageBytes = nil
+	missingRSS := completeContainerStats("a", 10, nil, false)
+	missingRSS.stats.Memory.RssBytes = nil
+	missingFaults := completeContainerStats("a", 10, nil, false)
+	missingFaults.stats.Memory.PageFaults = nil
+	missingMajorFaults := completeContainerStats("a", 10, nil, false)
+	missingMajorFaults.stats.Memory.MajorPageFaults = nil
+
+	tests := []struct {
+		name    string
+		css     []containerStats
+		running map[string]struct{}
+	}{
+		{name: "no running containers"},
+		{name: "running metric absent", css: []containerStats{completeA}, running: map[string]struct{}{"a": {}, "b": {}}},
+		{name: "cpu absent", css: []containerStats{missingCPU}, running: map[string]struct{}{"a": {}}},
+		{name: "memory absent", css: []containerStats{missingMemory}, running: map[string]struct{}{"a": {}}},
+		{name: "core usage absent", css: []containerStats{missingCoreUsage}, running: map[string]struct{}{"a": {}}},
+		{name: "working set absent", css: []containerStats{missingWorkingSet}, running: map[string]struct{}{"a": {}}},
+		{name: "usage absent", css: []containerStats{missingUsage}, running: map[string]struct{}{"a": {}}},
+		{name: "rss absent", css: []containerStats{missingRSS}, running: map[string]struct{}{"a": {}}},
+		{name: "page faults absent", css: []containerStats{missingFaults}, running: map[string]struct{}{"a": {}}},
+		{name: "major page faults absent", css: []containerStats{missingMajorFaults}, running: map[string]struct{}{"a": {}}},
+		{name: "cpu and memory split", css: []containerStats{cpuOnlyA, memoryOnlyB}, running: map[string]struct{}{"a": {}, "b": {}}},
+		{name: "duplicate running metric", css: []containerStats{completeA, duplicateA}, running: map[string]struct{}{"a": {}}},
+		{name: "one of two incomplete", css: []containerStats{completeA, incompleteB}, running: map[string]struct{}{"a": {}, "b": {}}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			cpu, memory, io, complete := aggregateSandboxStats(test.css, test.running, 100)
+			if complete || cpu != nil || memory != nil || io != nil {
+				t.Fatalf("incomplete aggregate must select Host fallback: complete=%v cpu=%v memory=%v io=%v", complete, cpu, memory, io)
+			}
+		})
+	}
+}
