+func saturatingAdd(left, right uint64) uint64 {
+	if ^uint64(0)-left < right {
+		return ^uint64(0)
+	}
+	return left + right
+}
+
+func addUInt64(target **runtime.UInt64Value, value *runtime.UInt64Value) {
+	if value == nil {
+		return
+	}
+	if *target == nil {
+		*target = &runtime.UInt64Value{}
+	}
+	(*target).Value = saturatingAdd((*target).Value, value.Value)
+}
