+func TestAggregateSandboxStatsComplete(t *testing.T) {
+	psiA := &runtime.PsiStats{Some: &runtime.PsiData{Total: 13}}
+	psiB := &runtime.PsiStats{Some: &runtime.PsiData{Total: 43}}
+	css := []containerStats{
+		completeContainerStats("a", 10, psiA, true),
+		completeContainerStats("b", 40, psiB, true),
+		{stats: &runtime.ContainerStats{Attributes: &runtime.ContainerAttributes{Id: "exited"}}},
+	}
+	running := map[string]struct{}{"a": {}, "b": {}}
+
+	cpu, memory, io, complete := aggregateSandboxStats(css, running, 200)
+	if !complete {
+		t.Fatal("complete running-container metrics must aggregate")
+	}
+	if cpu.Timestamp != 41 || cpu.UsageCoreNanoSeconds.Value != 54 || cpu.UsageNanoCores.Value != 56 {
+		t.Fatalf("unexpected CPU aggregate: %+v", cpu)
+	}
+	if cpu.Psi != nil {
+		t.Fatalf("multi-container CPU PSI must remain unavailable: %+v", cpu.Psi)
+	}
+	if memory.Timestamp != 44 || memory.WorkingSetBytes.Value != 60 || memory.AvailableBytes.Value != 140 || memory.UsageBytes.Value != 64 || memory.RssBytes.Value != 66 || memory.PageFaults.Value != 68 || memory.MajorPageFaults.Value != 70 {
+		t.Fatalf("unexpected memory aggregate: %+v", memory)
+	}
+	if memory.Psi != nil {
+		t.Fatalf("multi-container memory PSI must remain unavailable: %+v", memory.Psi)
+	}
+	if io != nil {
+		t.Fatalf("multi-container IO without aggregatable data must remain nil: %+v", io)
+	}
+}
