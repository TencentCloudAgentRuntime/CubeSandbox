+	withoutNanoCores := completeContainerStats("a", 10, nil, false)
+	withoutNanoCores.stats.Cpu.UsageNanoCores = nil
+	cpu, _, io, complete := aggregateSandboxStats([]containerStats{withoutNanoCores}, running, 0)
+	if !complete || cpu.UsageNanoCores != nil || io != nil {
+		t.Fatalf("optional nano cores and IO must remain nil: complete=%v cpu=%+v io=%+v", complete, cpu, io)
+	}
+
+	unlimited := completeContainerStats("a", 10, nil, false)
+	_, memory, _, complete := aggregateSandboxStats([]containerStats{unlimited}, running, (1<<62)+1)
+	if !complete || memory.AvailableBytes != nil {
+		t.Fatalf("unlimited memory must keep available nil: complete=%v memory=%+v", complete, memory)
+	}
+
+	overLimit := completeContainerStats("a", 10, nil, false)
+	_, memory, _, complete = aggregateSandboxStats([]containerStats{overLimit}, running, 10)
+	if !complete || memory.AvailableBytes == nil || memory.AvailableBytes.Value != 0 {
+		t.Fatalf("working set above limit must clamp available to zero: complete=%v memory=%+v", complete, memory)
+	}
+}
