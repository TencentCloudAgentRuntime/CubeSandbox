+func TestSandboxStatusWithUpdatedResources(t *testing.T) {
+	resources := &runtime.LinuxContainerResources{MemoryLimitInBytes: 200}
+	overhead := &runtime.LinuxContainerResources{MemoryLimitInBytes: 20}
+	status := sandboxStatusWithUpdatedResources(sandboxstore.StateReady, podsandbox.UpdatedResources{
+		Resources: resources,
+		Overhead:  overhead,
+	})
+	if status.State != sandboxstore.StateReady || status.Resources.GetLinux() != resources || status.Overhead.GetLinux() != overhead {
+		t.Fatalf("updated resources were not restored: %+v", status)
+	}
+
+	status = sandboxStatusWithUpdatedResources(sandboxstore.StateNotReady, podsandbox.UpdatedResources{})
+	if status.State != sandboxstore.StateNotReady || status.Resources != nil || status.Overhead != nil {
+		t.Fatalf("absent updated resources must remain nil: %+v", status)
+	}
+}
