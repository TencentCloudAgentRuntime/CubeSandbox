+func TestAggregateSandboxStatsSaturates(t *testing.T) {
+	maximum := ^uint64(0)
+	first := completeContainerStats("a", 1, nil, false)
+	second := completeContainerStats("b", 1, nil, false)
+	first.stats.Memory.UsageBytes = uint64Value(maximum - 1)
+	second.stats.Memory.UsageBytes = uint64Value(10)
+	running := map[string]struct{}{"a": {}, "b": {}}
+
+	_, memory, _, complete := aggregateSandboxStats([]containerStats{first, second}, running, 100)
+	if !complete || memory.UsageBytes.Value != maximum {
+		t.Fatalf("overflow must saturate, complete=%v memory=%+v", complete, memory)
+	}
+}
