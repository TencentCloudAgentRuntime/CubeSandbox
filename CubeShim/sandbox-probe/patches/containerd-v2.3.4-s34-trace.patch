+
+// Package s34trace is a temporary, object-scoped PoC trace. An empty or
+// missing allow-list is a no-op. It must be removed after S3.4a evidence is
+// captured.
+package s34trace
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"google.golang.org/protobuf/proto"
+)
+
+const root = "/run/cubesandbox-s34-trace"
+
+type metadata struct {
+	Kind       string `json:"kind"`
+	ObjectID   string `json:"objectID"`
+	Schema     string `json:"schema"`
+	SHA256     string `json:"sha256"`
+	CapturedAt string `json:"capturedAt"`
+}
+
+// Capture writes deterministic protobuf bytes before the traced request is
+// forwarded. Only exact IDs listed one-per-line in root/ids are eligible.
+func Capture(kind, objectID string, message proto.Message) error {
+	allowed, err := isAllowed(objectID)
+	if err != nil || !allowed {
+		return err
+	}
+	raw, err := proto.MarshalOptions{Deterministic: true}.Marshal(message)
+	if err != nil {
+		return err
+	}
+	directory := filepath.Join(root, objectID)
+	if err := os.MkdirAll(directory, 0o700); err != nil {
+		return err
+	}
+	stamp := fmt.Sprintf("%020d", time.Now().UnixNano())
+	base := filepath.Join(directory, stamp+"-"+kind)
+	if err := atomicWrite(base+".pb", raw, 0o600); err != nil {
+		return err
+	}
+	sum := sha256.Sum256(raw)
+	meta, err := json.MarshalIndent(metadata{
+		Kind:       kind,
+		ObjectID:   objectID,
+		Schema:     string(message.ProtoReflect().Descriptor().FullName()),
+		SHA256:     hex.EncodeToString(sum[:]),
+		CapturedAt: time.Now().UTC().Format(time.RFC3339Nano),
+	}, "", "  ")
+	if err != nil {
+		return err
+	}
+	return atomicWrite(base+".json", append(meta, '\n'), 0o600)
+}
+
+func isAllowed(objectID string) (bool, error) {
+	if objectID == "" || strings.ContainsAny(objectID, "/\\") {
+		return false, nil
+	}
+	file, err := os.Open(filepath.Join(root, "ids"))
+	if os.IsNotExist(err) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	defer file.Close()
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		if scanner.Text() == objectID {
+			return true, nil
+		}
+	}
+	return false, scanner.Err()
+}
+
+func atomicWrite(path string, data []byte, mode os.FileMode) error {
+	temporary := path + ".tmp"
+	if err := os.WriteFile(temporary, data, mode); err != nil {
+		return err
+	}
+	if err := os.Rename(temporary, path); err != nil {
+		_ = os.Remove(temporary)
+		return err
+	}
+	return nil
+}
