@@ -18,6 +18,7 @@ package sandbox
 
 import (
 	"context"
+	"encoding/json"
 	"fmt"
 	"os"
 	"time"
@@ -31,6 +32,7 @@ import (
 	imagespec "github.com/opencontainers/image-spec/specs-go/v1"
 
 	runtimeAPI "github.com/containerd/containerd/api/runtime/sandbox/v1"
+	taskAPI "github.com/containerd/containerd/api/runtime/task/v3"
 	"github.com/containerd/containerd/api/types"
 
 	"github.com/containerd/containerd/v2/core/events"
@@ -39,9 +41,23 @@ import (
 	"github.com/containerd/containerd/v2/core/runtime"
 	v2 "github.com/containerd/containerd/v2/core/runtime/v2"
 	"github.com/containerd/containerd/v2/core/sandbox"
+	"github.com/containerd/containerd/v2/internal/cri/server/podsandbox"
 	"github.com/containerd/containerd/v2/plugins"
+	"google.golang.org/protobuf/types/known/anypb"
 )
 
+const (
+	cubeRuntimeName                = "io.containerd.cube.rs"
+	cubePodSandboxResourcesTypeURL = "io.cubesandbox.runtime.v1.PodSandboxResources"
+)
+
+type cubePodSandboxResources struct {
+	CPUPeriod          int64 `json:"cpu_period"`
+	CPUQuota           int64 `json:"cpu_quota"`
+	CPUShares          int64 `json:"cpu_shares"`
+	MemoryLimitInBytes int64 `json:"memory_limit_in_bytes"`
+}
+
 func init() {
 	registry.Register(&plugin.Registration{
 		Type: plugins.SandboxControllerPlugin,
@@ -341,6 +357,61 @@ func (c *controllerLocal) Update(
 	sandboxID string,
 	sandbox sandbox.Sandbox,
 	fields ...string) error {
+	if sandbox.Runtime.Name != cubeRuntimeName {
+		return nil
+	}
+	if len(fields) > 0 {
+		updatesExtensions := false
+		for _, field := range fields {
+			if field == "extensions" || field == "extensions."+podsandbox.UpdatedResourcesKey {
+				updatesExtensions = true
+				break
+			}
+		}
+		if !updatesExtensions {
+			return nil
+		}
+	}
+	if _, ok := sandbox.Extensions[podsandbox.UpdatedResourcesKey]; !ok {
+		return nil
+	}
+
+	var updated podsandbox.UpdatedResources
+	if err := sandbox.GetExtension(podsandbox.UpdatedResourcesKey, &updated); err != nil {
+		return fmt.Errorf("get Cube sandbox updated resources: %w", err)
+	}
+	if updated.Resources == nil {
+		return fmt.Errorf("Cube sandbox updated resources are empty")
+	}
+	payload, err := json.Marshal(cubePodSandboxResources{
+		CPUPeriod:          updated.Resources.CpuPeriod,
+		CPUQuota:           updated.Resources.CpuQuota,
+		CPUShares:          updated.Resources.CpuShares,
+		MemoryLimitInBytes: updated.Resources.MemoryLimitInBytes,
+	})
+	if err != nil {
+		return fmt.Errorf("marshal Cube sandbox updated resources: %w", err)
+	}
+
+	shim, err := c.shims.Get(ctx, sandboxID)
+	if err != nil {
+		return fmt.Errorf("get Cube sandbox shim %q: %w", sandboxID, err)
+	}
+	_, version := shim.Endpoint()
+	client, err := v2.NewTaskClient(shim.Client(), version)
+	if err != nil {
+		return fmt.Errorf("create Cube sandbox Task client: %w", err)
+	}
+	_, err = client.Update(ctx, &taskAPI.UpdateTaskRequest{
+		ID: sandboxID,
+		Resources: &anypb.Any{
+			TypeUrl: cubePodSandboxResourcesTypeURL,
+			Value:   payload,
+		},
+	})
+	if err != nil {
+		return fmt.Errorf("update Cube sandbox VM resources: %w", err)
+	}
 	return nil
 }
 
